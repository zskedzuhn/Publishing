{% comment %}Split Sheet — Get the PDF (replaces the retired online builder){% endcomment %}
<style>
#shopify-section-header,#shopify-section-footer,header[role="banner"],footer[role="contentinfo"],.site-header,.site-footer,.header-wrapper,.footer-wrapper{display:none!important}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--black:#0a0a0a;--white:#fff;--off:#f7f7f5;--g1:#1a1a1a;--g2:#555;--g3:#999;--rule:#e2e2e2;--font:'Helvetica Neue',Helvetica,Arial,sans-serif;--max:720px}
body{font-family:var(--font);background:var(--white);color:var(--black);line-height:1.6;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}
.mss-nav{position:sticky;top:0;z-index:100;background:var(--white);border-bottom:1px solid var(--rule);padding:0 24px;height:52px;display:flex;align-items:center;justify-content:space-between}
.mss-nav-logo{font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
.mss-back{font-size:12px;color:var(--g2)}.mss-back:hover{color:var(--black)}
.mss-pg{max-width:var(--max);margin:0 auto;padding:72px 24px 80px;text-align:center}
.mss-h1{font-size:clamp(28px,5vw,40px);font-weight:700;letter-spacing:-.02em;margin-bottom:14px}
.mss-sub{font-size:15px;color:var(--g2);max-width:480px;margin:0 auto 48px;line-height:1.65}
.mss-cards{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;text-align:left}
.mss-card{border:1.5px solid var(--rule);border-radius:4px;padding:32px 28px;width:280px;position:relative}
.mss-card.featured{border-color:var(--black)}
.mss-cbadge{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--black);color:var(--white);font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:3px 10px;border-radius:2px;white-space:nowrap}
.mss-card h3{font-size:11px;font-weight:600;margin-bottom:6px;color:var(--g2);letter-spacing:.05em;text-transform:uppercase}
.mss-amount{font-size:38px;font-weight:700;letter-spacing:-.03em;line-height:1;margin-bottom:8px}
.mss-amount sup{font-size:18px;vertical-align:super;font-weight:500}
.mss-desc{font-size:12px;color:var(--g2);margin-bottom:20px;line-height:1.5}
.mss-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-size:13px;font-weight:600;letter-spacing:.02em;padding:13px 24px;border-radius:3px;cursor:pointer;transition:opacity .15s;border:none;background:var(--black);color:var(--white);width:100%}
.mss-btn:hover{opacity:.85}
.mss-more{display:block;text-align:center;font-size:12px;color:var(--g3);margin-top:10px;text-decoration:underline}.mss-more:hover{color:var(--black)}
.mss-note{font-size:12px;color:var(--g3);margin-top:36px;line-height:1.6}
.mss-note a{text-decoration:underline}
.mss-foot{border-top:1px solid var(--rule);padding:24px;text-align:center;font-size:11px;color:var(--g3);margin-top:60px}
@media(max-width:640px){.mss-card{width:100%}}
</style>

<nav class="mss-nav">
  <a href="/" class="mss-nav-logo">musicsplitsheets.com</a>
  <a href="/" class="mss-back">&larr; Back</a>
</nav>

<div class="mss-pg">
  <h1 class="mss-h1">Get your split sheet.</h1>
  <p class="mss-sub">The professional fillable split sheet PDF &mdash; buy it once, download instantly, and reuse it for every song you ever release. Type into the fields or print and fill by hand.</p>

  <div class="mss-cards">
    <div class="mss-card">
      <h3>Split Sheet</h3>
      <div class="mss-amount"><sup>$</sup>7</div>
      <p class="mss-desc">Publishing + master recording splits, all metadata fields, notes section, and 6 signature blocks.</p>
      <a href="/cart/51809201160474:1" class="mss-btn">Buy Now &mdash; $7 &rarr;</a>
      <a href="/products/music-split-sheet" class="mss-more">See full details</a>
    </div>
    <div class="mss-card featured">
      <div class="mss-cbadge">Most Complete</div>
      <h3>Split Sheet + LOD</h3>
      <div class="mss-amount"><sup>$</sup>12</div>
      <p class="mss-desc">Everything in the Split Sheet, plus a Letter of Direction for SoundExchange royalty designation.</p>
      <a href="/cart/51810791850266:1" class="mss-btn">Buy Now &mdash; $12 &rarr;</a>
      <a href="/products/music-split-sheet-letter-of-direction" class="mss-more">See full details</a>
    </div>
  </div>

  <p class="mss-note">Used our old online builder and need your document? Your <a href="/pages/download">download page</a> still works in the browser you used, or email <a href="mailto:hello@musicsplitsheets.com">hello@musicsplitsheets.com</a> and we'll sort you out.</p>
</div>

<footer class="mss-foot">&copy; 2026 musicsplitsheets.com &mdash; All rights reserved.</footer>
{% schema %}{"name":"Split Sheet Form","settings":[]}{% endschema %}
